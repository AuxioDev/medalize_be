# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost
# All doctors/workplaces/appointments are treated as being in this one
# timezone (see the comment on TIME_ZONE in config/settings.py). Must match
# where doctors actually practice.
TIME_ZONE=Asia/Baku

# Database — DB_PASSWORD is required, no fallback (docker-compose's Postgres
# container also has none — a forgotten value fails the deploy immediately
# instead of silently running with a known weak password).
DB_NAME=medalize_db
DB_USER=medalizer_user
DB_PASSWORD=strong-password-here
DB_HOST=postgres
DB_PORT=5432

# JWT — MUST be different from SECRET_KEY above; both must be ≥50 chars.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-50-characters-long-different-from-secret-key

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@medalize.com

# CORS — origins allowed to call the API (web frontends). Mobile apps don't need this.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Redis (Celery broker + cache). REDIS_PASSWORD is required, no fallback —
# docker-compose passes it to both the Redis server (--requirepass) and every
# client (web/worker/beat), so Redis is never reachable unauthenticated even
# though it's already not published to the host.
REDIS_PASSWORD=another-strong-password-here
REDIS_URL=redis://:another-strong-password-here@redis:6379/0

# Cloudinary CDN (media: doctor diplomas, avatars). Files are uploaded as
# Cloudinary's private "authenticated" delivery type and always served via a
# signed URL — never a plain public one. Leave blank to store uploads on the
# local filesystem instead (development default).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Enables genuinely time-limited (5 min) signed URLs via
# Cloudinary's "token-based authentication" add-on (Console > Settings >
# Security > generate a token key — separate from the API secret above).
# Leave blank and URLs are still signed/un-guessable, just without a
# checkable expiry.
CLOUDINARY_AUTH_TOKEN_KEY=

# Firebase Admin SDK — path to serviceAccountKey.json for FCM push notifications.
# Leave blank to disable push (email + in-app notifications still work).
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key.
FIREBASE_CREDENTIALS_JSON=

# Social login — Google Sign-In.
# Comma-separated OAuth client ids accepted as the `aud` claim of Google
# id_tokens (iOS + Android + web client ids from Google Cloud / Firebase Console).
# Leave blank to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_IDS=

# AI symptom assistant (local template matching, no external API).
# Leave blank to disable it (all /api/assistant/ endpoints answer 503).
# ASSISTANT_ENCRYPTION_KEY — Fernet key encrypting chat messages at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSISTANT_ENCRYPTION_KEY=

# Social login — Sign in with Apple.
# Comma-separated bundle ids accepted as the `aud` claim of Apple id_tokens
# (the app's bundle identifier registered in the Apple Developer portal).
# Leave blank to disable Apple sign-in.
APPLE_BUNDLE_IDS=

# In-app payments. PAYMENT_PROVIDER selects which
# apps/payments/providers/*.py backs every payment surface (appointments,
# doctor/hospital subscriptions):
#   mock    — (current default) a same-backend fake card-entry page marks
#             the order paid on submit. No credentials needed, no real API
#             calls made. Temporary stand-in until Payriff is verified.
#   payriff — the real integration (payriff.com). Requires both
#             PAYRIFF_MERCHANT_ID and PAYRIFF_SECRET_KEY below — leave
#             either blank and payment endpoints answer 503 (booking still
#             works normally either way). See
#             apps/payments/providers/payriff.py for the signing scheme and
#             its docstring for what's unverified and needs re-checking
#             before production.
PAYMENT_PROVIDER=mock
PAYRIFF_MERCHANT_ID=
PAYRIFF_SECRET_KEY=
# Absolute base URL of this backend (no trailing slash), used to build the
# approve/cancel/decline redirect URLs handed to the active payment
# provider at checkout (and, for the mock provider, the fake checkout page
# URL itself).
BACKEND_BASE_URL=http://localhost:8000
